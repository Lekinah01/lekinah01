<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AutomEight™ — Services & Pricing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --g:    #1D9E75;
  --gd:   #0F6E56;
  --gdp:  #085041;
  --gl:   #E1F5EE;
  --gm:   #b8e8d8;
  --ink:  #1A1A18;
  --dim:  #5A5A56;
  --faint:#8E8E89;
  --bg:   #F6F6F2;
  --card: #FFFFFF;
  --line: rgba(26,26,24,0.09);
  --line2:rgba(26,26,24,0.16);
  --r:    10px;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ─── NAV ─── */
nav {
  position: sticky; top: 0; z-index: 200;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 48px; height: 60px;
  background: rgba(246,246,242,0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.nav-logo {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 17px;
  letter-spacing: -0.03em; color: var(--ink);
}
.nav-logo sup { color: var(--g); font-size: 10px; letter-spacing: 0; }
.nav-links { display: flex; gap: 32px; }
.nav-links a {
  font-size: 13px; font-weight: 500; color: var(--dim);
  text-decoration: none; transition: color .15s;
}
.nav-links a:hover { color: var(--ink); }
.nav-cta {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.04em; padding: 9px 18px; border-radius: 6px;
  background: var(--ink); color: #fff; text-decoration: none; cursor: pointer;
  border: none; transition: background .15s;
}
.nav-cta:hover { background: #2d2d2a; }

/* ─── HERO ─── */
.hero {
  padding: 100px 48px 80px;
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
}
.hero-eyebrow {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase; color: var(--g);
  margin-bottom: 16px;
}
.hero-h1 {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 52px;
  letter-spacing: -0.04em; line-height: 1.0; color: var(--ink);
  margin-bottom: 20px;
}
.hero-h1 em { font-style: normal; color: var(--g); }
.hero-sub {
  font-size: 16px; color: var(--dim); line-height: 1.75; margin-bottom: 32px;
  max-width: 440px;
}
.hero-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.btn-primary {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.04em; padding: 12px 22px; border-radius: 7px;
  background: var(--g); color: #fff; text-decoration: none; border: none;
  cursor: pointer; transition: background .15s, transform .1s;
}
.btn-primary:hover { background: var(--gd); transform: translateY(-1px); }
.btn-ghost {
  font-size: 13px; font-weight: 500; color: var(--dim); text-decoration: none;
  display: flex; align-items: center; gap: 6px;
}
.btn-ghost:hover { color: var(--ink); }

.hero-right { position: relative; }
.hero-card-stack { position: relative; }
.outcome-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--card); border: 1px solid var(--line);
  border-radius: 100px; padding: 8px 14px 8px 10px;
  font-size: 13px; font-weight: 500; color: var(--ink);
  box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  white-space: nowrap;
}
.outcome-pill .dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--g);
  flex-shrink: 0;
}
.pill-grid {
  display: flex; flex-direction: column; gap: 10px;
}
.pill-row { display: flex; gap: 10px; justify-content: flex-start; }
.pill-row:nth-child(2) { padding-left: 24px; }
.pill-row:nth-child(3) { padding-left: 8px; }

/* ─── YEAR 1 STRIP ─── */
.y1-strip {
  background: var(--ink); margin: 0 48px;
  border-radius: 14px; padding: 40px 48px;
  display: flex; justify-content: space-between; align-items: center; gap: 40px;
  max-width: 1004px; margin: 0 auto 80px; position: relative; overflow: hidden;
}
.y1-strip::before {
  content: '';
  position: absolute; top: -60px; right: 40px;
  width: 200px; height: 200px; border-radius: 50%;
  background: radial-gradient(circle, rgba(29,158,117,0.2) 0%, transparent 70%);
  pointer-events: none;
}
.y1-badge {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  background: rgba(29,158,117,0.15); color: var(--g);
  border: 1px solid rgba(29,158,117,0.3); padding: 4px 10px; border-radius: 4px;
  margin-bottom: 12px; display: inline-block;
}
.y1-title {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 22px;
  color: #fff; letter-spacing: -0.02em; margin-bottom: 8px;
}
.y1-sub { font-size: 14px; color: rgba(255,255,255,0.45); max-width: 360px; line-height: 1.6; }
.y1-path {
  display: flex; align-items: center; gap: 0; flex-shrink: 0;
}
.y1-node {
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px; padding: 12px 18px; text-align: center;
}
.y1-node-num {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--g);
  letter-spacing: 0.08em; margin-bottom: 4px;
}
.y1-node-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; }
.y1-arrow {
  font-size: 16px; color: rgba(255,255,255,0.2);
  padding: 0 10px; flex-shrink: 0;
}
.y1-node.highlighted {
  background: rgba(29,158,117,0.15); border-color: rgba(29,158,117,0.4);
}
.y1-node.highlighted .y1-node-name { color: var(--g); }

/* ─── SECTION HEADER ─── */
.section-header {
  max-width: 1100px; margin: 0 auto; padding: 0 48px;
  margin-bottom: 40px;
}
.section-header .eyebrow {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase; color: var(--g); margin-bottom: 10px;
}
.section-header h2 {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 36px;
  letter-spacing: -0.03em; color: var(--ink); line-height: 1.1;
}
.section-header p {
  font-size: 15px; color: var(--dim); margin-top: 10px; max-width: 540px; line-height: 1.7;
}

/* ─── PACKAGES ─── */
.packages-wrap { max-width: 1100px; margin: 0 auto; padding: 0 48px 100px; }

/* ─── PACKAGE CARD ─── */
.pkg {
  background: var(--card); border: 1px solid var(--line);
  border-radius: 16px; overflow: hidden; margin-bottom: 24px;
  transition: border-color .2s, box-shadow .2s;
}
.pkg:hover { border-color: rgba(29,158,117,0.3); box-shadow: 0 8px 40px rgba(29,158,117,0.07); }
.pkg.featured { border-color: var(--g); border-width: 1.5px; }

.pkg-header {
  padding: 36px 40px 32px;
  display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start;
  border-bottom: 1px solid var(--line);
}
.pkg-num {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--g); margin-bottom: 8px;
}
.pkg-name {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 26px;
  letter-spacing: -0.03em; color: var(--ink); margin-bottom: 8px; line-height: 1.1;
}
.pkg-purpose { font-size: 14px; color: var(--dim); line-height: 1.6; max-width: 500px; }
.pkg-price-block { text-align: right; flex-shrink: 0; }
.pkg-from {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--faint);
  letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px;
}
.pkg-price {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 28px;
  color: var(--ink); letter-spacing: -0.03em; white-space: nowrap;
}
.pkg-price-range {
  font-size: 12px; color: var(--dim); margin-top: 2px;
}
.pkg-timeline {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--g);
  letter-spacing: 0.06em; margin-top: 8px;
}
.featured-badge {
  display: inline-block; background: var(--g); color: #fff;
  font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 10px; border-radius: 4px;
  margin-bottom: 10px;
}

.pkg-body {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0;
}
.pkg-col {
  padding: 28px 32px;
  border-right: 1px solid var(--line);
}
.pkg-col:last-child { border-right: none; }
.pkg-col-label {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint);
  margin-bottom: 14px;
}
.del-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }
.del-item {
  display: flex; align-items: flex-start; gap: 9px;
  font-size: 13px; line-height: 1.5; color: var(--ink);
}
.del-check {
  width: 16px; height: 16px; border-radius: 4px; background: var(--gl);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;
}
.del-check svg { width: 9px; height: 9px; }
.del-plus {
  width: 16px; height: 16px; border-radius: 4px; background: rgba(29,158,117,0.12);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;
}

.outcome-list { display: flex; flex-direction: column; gap: 0; }
.outcome-group { margin-bottom: 16px; }
.outcome-group-label {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--g);
  letter-spacing: 0.08em; margin-bottom: 6px;
}
.outcome-item {
  font-size: 13px; color: var(--dim); padding: 5px 0;
  border-bottom: 1px solid var(--line); line-height: 1.4;
}
.outcome-item:last-child { border-bottom: none; }
.outcome-stat {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: 20px;
  color: var(--g); margin-bottom: 2px;
}
.outcome-stat-label { font-size: 12px; color: var(--dim); }
.outcome-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.outcome-stat-block {
  background: var(--bg); border-radius: 8px; padding: 14px;
}

.pkg-footer {
  padding: 20px 32px;
  border-top: 1px solid var(--line);
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  background: var(--bg);
}
.pkg-footer-note { font-size: 12px; color: var(--dim); }
.pkg-cta {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.04em; padding: 10px 20px; border-radius: 6px;
  cursor: pointer; border: none; transition: all .15s; white-space: nowrap; text-decoration: none;
  display: inline-block;
}
.pkg-cta-ghost {
  background: transparent; color: var(--g);
  border: 1px solid rgba(29,158,117,0.4);
}
.pkg-cta-ghost:hover { background: var(--gl); }
.pkg-cta-solid { background: var(--g); color: #fff; }
.pkg-cta-solid:hover { background: var(--gd); }
.pkg-cta-dark { background: var(--ink); color: #fff; }
.pkg-cta-dark:hover { background: #2d2d2a; }

/* ─── RETAINER CARD ─── */
.retainer-card {
  background: var(--ink); border-radius: 16px; overflow: hidden;
  margin-bottom: 24px; border: 1px solid rgba(255,255,255,0.06);
}
.retainer-header {
  padding: 36px 40px 28px; border-bottom: 1px solid rgba(255,255,255,0.08);
  display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start;
}
.retainer-num {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--g); margin-bottom: 8px;
}
.retainer-name {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 26px;
  letter-spacing: -0.03em; color: #fff; margin-bottom: 8px; line-height: 1.1;
}
.retainer-purpose { font-size: 14px; color: rgba(255,255,255,0.45); line-height: 1.6; max-width: 500px; }
.retainer-label {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--g);
  letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; opacity: 0.7;
}
.retainer-badge {
  display: inline-block; background: rgba(29,158,117,0.15);
  border: 1px solid rgba(29,158,117,0.3); color: var(--g);
  font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 10px; border-radius: 4px;
  margin-bottom: 12px;
}

.tiers-grid {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0;
}
.tier {
  padding: 28px 32px; border-right: 1px solid rgba(255,255,255,0.07);
  position: relative;
}
.tier:last-child { border-right: none; }
.tier.tier-highlight {
  background: rgba(29,158,117,0.08); border-right-color: rgba(29,158,117,0.2);
}
.tier-name {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px;
  color: #fff; margin-bottom: 4px;
}
.tier-price {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 32px;
  letter-spacing: -0.04em; color: #fff; margin-bottom: 2px;
  display: flex; align-items: baseline; gap: 4px;
}
.tier-price-per { font-size: 13px; font-weight: 400; color: rgba(255,255,255,0.35); }
.tier-tagline { font-size: 12px; color: rgba(255,255,255,0.4); margin-bottom: 18px; line-height: 1.5; }
.tier-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.tier-item {
  display: flex; align-items: flex-start; gap: 8px;
  font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.4;
}
.tier-dot {
  width: 5px; height: 5px; border-radius: 50%; background: var(--g);
  flex-shrink: 0; margin-top: 6px;
}
.tier-plus {
  width: 5px; height: 5px; border-radius: 50%; background: rgba(29,158,117,0.4);
  flex-shrink: 0; margin-top: 6px;
}
.tier-recommended {
  position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
  background: var(--g); color: #fff; font-family: 'JetBrains Mono', monospace;
  font-size: 9px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 3px 12px; border-radius: 0 0 6px 6px;
}
.retainer-footer {
  padding: 20px 32px; border-top: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.retainer-footer-note { font-size: 12px; color: rgba(255,255,255,0.3); }

/* ─── COMPARISON TABLE ─── */
.compare-section { max-width: 1100px; margin: 0 auto; padding: 0 48px 100px; }
.compare-table { width: 100%; border-collapse: collapse; margin-top: 32px; }
.compare-table th, .compare-table td {
  padding: 14px 20px; text-align: left; font-size: 13px;
  border-bottom: 1px solid var(--line);
}
.compare-table thead th {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint);
  background: var(--card); padding-top: 16px; padding-bottom: 16px;
}
.compare-table thead th:first-child { border-radius: 10px 0 0 0; }
.compare-table thead th:last-child { border-radius: 0 10px 0 0; }
.compare-table tbody tr:last-child td { border-bottom: none; }
.compare-table tbody tr:hover td { background: rgba(29,158,117,0.02); }
.compare-table tbody td:first-child { font-weight: 500; }
.compare-table tbody td { color: var(--dim); }
.compare-table tbody td:first-child { color: var(--ink); }
.compare-wrap {
  background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
}
.tick { color: var(--g); font-weight: 600; }
.dash { color: var(--line2); }

/* ─── IDEAL FOR ─── */
.ideal-section { max-width: 1100px; margin: 0 auto; padding: 0 48px 80px; }
.ideal-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 32px; }
.ideal-card {
  background: var(--card); border: 1px solid var(--line); border-radius: 12px;
  padding: 24px; transition: border-color .15s;
}
.ideal-card:hover { border-color: var(--gm); }
.ideal-icon { font-size: 22px; margin-bottom: 12px; }
.ideal-industry {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: 16px; margin-bottom: 6px;
}
.ideal-role { font-size: 12px; color: var(--dim); margin-bottom: 14px; }
.ideal-pains { display: flex; flex-direction: column; gap: 6px; }
.ideal-pain {
  font-size: 12px; color: var(--dim); display: flex; align-items: flex-start; gap: 8px;
  padding: 6px 10px; background: var(--bg); border-radius: 6px; line-height: 1.4;
}
.ideal-pain::before { content: '→'; color: var(--g); flex-shrink: 0; font-size: 11px; }

/* ─── FAQ ─── */
.faq-section { max-width: 760px; margin: 0 auto; padding: 0 48px 100px; }
.faq-item {
  border-bottom: 1px solid var(--line); padding: 20px 0; cursor: pointer;
}
.faq-q {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px;
  display: flex; justify-content: space-between; align-items: center; gap: 20px;
}
.faq-icon { font-size: 18px; color: var(--g); flex-shrink: 0; transition: transform .2s; }
.faq-a { font-size: 14px; color: var(--dim); line-height: 1.75; max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s; padding-top: 0; }
.faq-item.open .faq-a { max-height: 300px; padding-top: 12px; }
.faq-item.open .faq-icon { transform: rotate(45deg); }

/* ─── CTA BAND ─── */
.cta-band {
  background: var(--g); padding: 80px 48px;
  text-align: center;
}
.cta-band h2 {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 40px;
  letter-spacing: -0.04em; color: #fff; margin-bottom: 12px; line-height: 1.1;
}
.cta-band p { font-size: 16px; color: rgba(255,255,255,0.7); margin-bottom: 32px; }
.cta-band-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.btn-white {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.04em; padding: 14px 26px; border-radius: 7px;
  background: #fff; color: var(--g); text-decoration: none; cursor: pointer;
  border: none; transition: all .15s;
}
.btn-white:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,0.12); }
.btn-outline-white {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 500;
  letter-spacing: 0.04em; padding: 14px 26px; border-radius: 7px;
  background: transparent; color: #fff; text-decoration: none; cursor: pointer;
  border: 1.5px solid rgba(255,255,255,0.4); transition: all .15s;
}
.btn-outline-white:hover { border-color: #fff; background: rgba(255,255,255,0.1); }

/* ─── FOOTER ─── */
footer {
  background: var(--ink); padding: 40px 48px;
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
}
.footer-logo {
  font-family: 'Syne', sans-serif; font-weight: 800; font-size: 16px; color: #fff;
}
.footer-logo sup { color: var(--g); }
.footer-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.3); }

/* ─── RESPONSIVE ─── */
@media (max-width: 900px) {
  nav { padding: 0 20px; }
  .nav-links { display: none; }
  .hero { grid-template-columns: 1fr; padding: 60px 20px 48px; gap: 40px; }
  .hero-h1 { font-size: 38px; }
  .y1-strip { padding: 28px 20px; flex-direction: column; gap: 24px; margin: 0 20px 60px; }
  .y1-path { flex-wrap: wrap; justify-content: center; }
  .packages-wrap, .compare-section, .ideal-section, .faq-section { padding: 0 20px 60px; }
  .section-header { padding: 0 20px; }
  .pkg-header { grid-template-columns: 1fr; }
  .pkg-price-block { text-align: left; }
  .pkg-body { grid-template-columns: 1fr; }
  .pkg-col { border-right: none; border-bottom: 1px solid var(--line); }
  .pkg-col:last-child { border-bottom: none; }
  .tiers-grid { grid-template-columns: 1fr; }
  .tier { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .tier:last-child { border-bottom: none; }
  .ideal-grid { grid-template-columns: 1fr; }
